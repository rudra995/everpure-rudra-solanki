# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Snowflake (key-pair auth for the service user created in sql/snowflake/00_bootstrap.sql)
# Account identifier: Snowsight > bottom-left account menu > "Connect a tool to Snowflake"
# Format: <orgname>-<accountname>, e.g. ABCDEFG-XY12345
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=PI_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=keys/snowflake_rsa_key.p8
SNOWFLAKE_WAREHOUSE=PI_WH
SNOWFLAKE_DATABASE=PURE_INSIGHTS
SNOWFLAKE_DEPLOY_ROLE=PI_DEPLOY
SNOWFLAKE_APP_ROLE=PI_APP_SERVICE

# --- Backend (backend/)
# Data source for the API: duckdb (default, no account needed) or snowflake (live, uses the values above)
DATA_SOURCE=duckdb
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Required for anything beyond a local demo. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Password shared by the 4 demo users
DEMO_PASSWORD=demo123
# Telemetry replay speed (ms per snapshot) and whether it starts automatically
SIM_INTERVAL_MS=1000
SIM_AUTOSTART=true
