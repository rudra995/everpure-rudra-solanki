# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Snowflake (key-pair auth for the service user created in sql/snowflake/00_bootstrap.sql)
# Account identifier: Snowsight > bottom-left account menu > "Connect a tool to Snowflake"
# Format: <orgname>-<accountname>, e.g. ABCDEFG-XY12345
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=PI_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=keys/snowflake_rsa_key.p8
SNOWFLAKE_WAREHOUSE=PI_WH
SNOWFLAKE_DATABASE=PURE_INSIGHTS
SNOWFLAKE_DEPLOY_ROLE=PI_DEPLOY
SNOWFLAKE_APP_ROLE=PI_APP_SERVICE
